# Copy to .env and fill what you have. Blank means "not configured": the tools
# that need it will refuse instead of pretending. Nothing here is required to
# boot the app; /api/health will name whatever is missing.

# --- core ---
APP_ENV=dev
APP_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=
DATABASE_URL=sqlite+aiosqlite:///./var/jarvis.db
OPERATOR_EMAIL=you@example.com

# written by scripts/setup_operator.py
OPERATOR_PASSWORD_HASH=
OPERATOR_TOTP_SECRET=

# --- models ---
# stub      = offline planner, no key, templated prose (orchestration is real)
# openai    = api.openai.com directly
# openrouter= one key for many vendors' models, OpenAI-compatible
#
# OpenRouter addresses models as vendor/model. A bare "gpt-4o-mini" is refused
# at startup instead of 404-ing halfway through a turn.
LLM_PROVIDER=stub

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# openai defaults; with LLM_PROVIDER=openrouter use slugs, e.g. openai/gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o-mini
LLM_MODEL_CHEAP=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- speech ---
DEEPGRAM_API_KEY=
DEEPGRAM_LANG_EN=en
DEEPGRAM_LANG_ZH=zh-TW
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_VOICE_EN=en-MY-YasminNeural
AZURE_VOICE_ZH=zh-TW-HsiaoChenNeural

# --- telephony ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE=
TWILIO_DEFAULT_LINE_E164=

# --- messaging / mail ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- safety ---
SANDBOX_IMAGE=
SANDBOX_EGRESS_ALLOWLIST=
MONTHLY_BUDGET_USD=20
BUDGET_ALARM_USD=15
FIXED_MONTHLY_USD=11.80
CALL_MAX_DURATION_S=600
APPROVAL_TTL_MINUTES=30
