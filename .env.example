# Copy to .env and fill what you have. Blank means "not configured": the tools
# that need it will refuse instead of pretending. Nothing here is required to
# boot the app; /api/health will name whatever is missing.

# --- core ---
APP_ENV=dev
APP_BASE_URL=http://127.0.0.1:8080
SECRET_KEY=
# SQLite (default) or Postgres/Supabase:
#   DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Port 5432 is the session pooler and works as-is. Port 6543 is the transaction
# pooler: the app disables asyncpg's statement cache for it automatically.
# Never commit this URL: it contains the database password.
DATABASE_URL=sqlite+aiosqlite:///./var/jarvis.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
OPERATOR_EMAIL=you@example.com

# written by scripts/setup_operator.py
OPERATOR_PASSWORD_HASH=
OPERATOR_TOTP_SECRET=

# --- models ---
# stub      = offline planner, no key, templated prose (orchestration is real)
# openai    = api.openai.com directly
# openrouter= one key for many vendors' models, OpenAI-compatible
#
# OpenRouter addresses models as vendor/model. A bare "gpt-4o-mini" is refused
# at startup instead of 404-ing halfway through a turn.
LLM_PROVIDER=stub

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Second source, tried in order when the first rate-limits or is down.
# Any name from providers/catalog.py: groq, gemini, cerebras, openai.
LLM_FALLBACKS=groq,gemini
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# openai defaults; with LLM_PROVIDER=openrouter use slugs, e.g. openai/gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o-mini
LLM_MODEL_CHEAP=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- speech ---
# tts: deepgram (English only, same key as STT) or elevenlabs (multilingual,
# free tier 10k chars/month) for Chinese
TTS_PROVIDER=deepgram
DEEPGRAM_TTS_MODEL_EN=aura-2-thalia-en
ELEVENLABS_API_KEY=
# blank voice id: pick one from /v1/voices at call time rather than guess
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
DEEPGRAM_API_KEY=
DEEPGRAM_LANG_EN=en
DEEPGRAM_LANG_ZH=zh-TW
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_VOICE_EN=en-MY-YasminNeural
AZURE_VOICE_ZH=zh-TW-HsiaoChenNeural

# --- telephony ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE=
TWILIO_DEFAULT_LINE_E164=

# --- messaging / mail ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- safety ---
SANDBOX_IMAGE=
SANDBOX_EGRESS_ALLOWLIST=
MONTHLY_BUDGET_USD=20
BUDGET_ALARM_USD=15
FIXED_MONTHLY_USD=11.80
CALL_MAX_DURATION_S=600
APPROVAL_TTL_MINUTES=30
